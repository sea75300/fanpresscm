{% include 'messages.html.twig' %}

{% include 'toolbar.html.twig' %}

<section>
    {% for article in articles %}
    <article>
    {% if fpcm.is_logged_in %}
        <div class="fpcm-pub-articletoolbar-article">
            {% if fpcm.permissions.can_edit %}
                <a class="btn" target="_blank" href="{{ article.editLink }}">{{ translate('GLOBAL_EDIT') }}</a>
            {% endif %}
        </div>
        {% endif %}
        <hr>
        <div class="post">
            <h3>{{ article.headline }}</h3>

            {% if article.statusPinned %}
            <div class="status-pinned">
                <p class="alert alert-info">{{ translate('PUBLIC_ARTICLE_PINNED') }}</p>
            </div>
            {% endif %}

            {% if article.oldarticle %}
            <div class="status-old">
                <p class="alert alert-warning">{{ translate('PUBLIC_ARTICLE_OLD') }}</p>
            </div>
            {% endif %}
            <div class="content">
                {{ article.textShort }}
            </div>
            <div class="categories">
                Kategorien: {{ article.categoryTexts|join(' ') }}
            </div>
            <div class="meta-info">
                <span class="date">{{ article.date }}</span> &bull;
                <span class="author">Author: <a href="mailto:{{ article.authorEmail }}">{{ article.author }}</a></span> &bull;
                <span class="link"><a href="{{ article.permaLink }}">Artikel-Link</a></span> &bull;
                {% if commentsActive and article.commentsActive %}
                    <span class="comment"><a href="{{ article.commentLink }}">{{ article.commentCount }} {{ translate('COMMMENT_HEADLINE') }}</a></span>
                {% endif %}
            </div>
            {% if article.sources %}
            <div class="source-links">
                Quelle(n): {{ article.sources }}
            </div>
            {% endif %}
            {% if fpcm.shares.show %}
            <div class="source-links">            
                {% set buttons = share_buttons(article.headline, article.permaLink) %}
                {% include 'sharebuttons.html.twig' with {'buttons': buttons, 'oid': article.id } %}
            </div>
            {% endif %}
        </div>
    </article>
    {% endfor %}
</section>

{% set pager = get_pager(pager_settings) %}

<section>
    <ul>
    {% if pager.previous %}
        <li><a href="{{ pager.previous }}" class="fpcm-pub-pagination-prev">&larr;</a></li>
    {% endif %}
    {% for page in pager.pages %}
        <li><a href="{{ page.link }}" {% if page.class %}class="{{ page.class }}"{% endif %}>{{ page.label }}</a></li>
    {% endfor %}
    {% if pager.next %}
        <li><a href="{{ pager.next }}" class="fpcm-pub-pagination-next">&rarr;</a></li>
    {% endif %}
    {% if pager.archive %}
        <li><a href="{{ pager.archive }}" class="fpcm-pub-pagination-archive">{{ translate('ARTICLES_PUBLIC_ARCHIVE') }}</a></li>
    {% endif %}
    </ul>
</section>