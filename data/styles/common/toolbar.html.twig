{% if fpcm.is_logged_in %}
<section>
    <div class="fpcm-pub-articletoolbar-main btn-group">
        {% if fpcm.permissions.can_add %}
            <a class="btn" target="_blank" href="{{ fpcm.basePath }}articles/add">{{ translate('HL_ARTICLE_ADD') }}</a>
        {% endif %}

        {% if fpcm.permissions.can_edit %}
        <a class="btn" target="_blank" href="{{ fpcm.basePath }}articles/listactive">{{ translate('HL_ARTICLE_EDIT_ACTIVE') }}</a>
        {% endif %}

        <a class="btn" href="{{ fpcm.basePath }}system/logout&redirect=1">{{ translate('LOGOUT_BTN') }}</a>
    </div>
</section>
{% endif %}