<section>
    <div id="commentform">
        <div class="post">
            <div class="content col-12">
                <h4>{{ form.formHeadline }}</h4>
                
                <form method="post" action="{{ form.submitUrl }}" name="cform">
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ translate('COMMMENT_AUTHOR') }}
                        </div>
                        <div class="col">
                            {{ input_field(form.nameField.name, form.nameField.value) }}
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ translate('GLOBAL_EMAIL') }}
                        </div>
                        <div class="col">
                            {{ input_field(form.emailField.name, form.emailField.value, 'email') }}
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ translate('COMMMENT_WEBSITE') }} (optional)
                        </div>
                        <div class="col">
                            {{ input_field(form.websiteField.name, form.websiteField.value, 'url') }}
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ translate('COMMENTS_PUBLIC_FORMHEADLINE') }}
                        </div>
                        <div class="col">
                            <div>
                                {{ textarea
                                    (
                                        name: form.textfield.name,
                                        value: form.textfield.value,
                                        id: form.textfield.id
                                    )
                                }}
                            </div>
                            <div class="px-2">
                                {{ translate('GLOBAL_HTMLTAGS_ALLOWED') }}: {{ form.tags.value|join(', ')|e }}
                            </div>
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ form.spamPlugin.text }}
                        </div>
                        <div class="col">
                            {{ form.spamPlugin.field }}
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-auto">
                            {{ checkbox(form.privateCheckbox.name) }}
                        </div>
                        <div class="col">
                            {{ translate('COMMMENT_PRIVATE') }}
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-auto">
                            {{ checkbox(form.privacyComfirmation.name, form.privacyComfirmation.value) }}
                        </div>
                        <div class="col">
                            {{ translate('PUBLIC_PRIVACY') }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col align-center">
                            <button id="fpcm-id-comment-send" type="submit" name="{{ form.submitButton.name }}">{{ translate('GLOBAL_SUBMIT') }}</button>
                            <button type="reset" name="{{ form.resetButton.name }}">{{ translate('GLOBAL_RESET') }}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>