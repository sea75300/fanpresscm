<!-- Start FanPress CM Share Buttons -->
<section>
    <ul class="fpcm-pub-sharebuttons">
        <li>
            <a class="fpcm-pub-sharebutton fpcm-pub-sharebutton-likeButton" href="#" data-onclick="likebutton" data-oid="{{ oid }}"{% if fpcm.shares.count %} data-count="true"{% endif %}>
                <img loading="lazy" src="{{ share_button_icon(buttons.likeButton.icon) }}" alt="Liken">
            </a>    
        </li>
        <li>
            <a class="fpcm-pub-sharebutton fpcm-pub-sharebutton-facebook" href="{{ buttons.facebook.link }}" target="_blank" data-onclick="facebook" data-oid="{{ oid }}"{% if fpcm.shares.count %} data-count="true"{% endif %}>
                <img loading="lazy" src="{{ share_button_icon(buttons.facebook.icon) }}" alt="Facebook">
            </a>    
        </li>
        <li>
            <a class="fpcm-pub-sharebutton fpcm-pub-sharebutton-twitter" href="{{ buttons.twitter.link }}" target="_blank" data-onclick="twitter" data-oid="{{ oid }}"{% if fpcm.shares.count %} data-count="true"{% endif %}>
                <img loading="lazy" src="{{ share_button_icon(buttons.twitter.icon) }}" alt="Twitter">
            </a>    
        </li>
        <li>
            <a class="fpcm-pub-sharebutton fpcm-pub-sharebutton-tumblr" href="{{ buttons.tumblr.link }}" target="_blank" data-onclick="tumblr" data-oid="{{ oid }}"{% if fpcm.shares.count %} data-count="true"{% endif %}>
                <img loading="lazy" src="{{ share_button_icon(buttons.tumblr.icon) }}" alt="Tumblr">
            </a>    
        </li>
        <li>
            <a class="fpcm-pub-sharebutton fpcm-pub-sharebutton-pinterest" href="{{ buttons.pinterest.link }}" target="_blank" data-onclick="pinterest" data-oid="{{ oid }}"{% if fpcm.shares.count %} data-count="true"{% endif %}>
                <img loading="lazy" src="{{ share_button_icon(buttons.pinterest.icon) }}" alt="Pinterest">
            </a>    
        </li>
        <li>
            <a class="fpcm-pub-sharebutton fpcm-pub-sharebutton-reddit" href="{{ buttons.reddit.link }}" target="_blank" data-onclick="reddit" data-oid="{{ oid }}"{% if fpcm.shares.count %} data-count="true"{% endif %}>
                <img loading="lazy" src="{{ share_button_icon(buttons.reddit.icon) }}" alt="Reddit">
            </a>    
        </li>
        <li>
            <a class="fpcm-pub-sharebutton fpcm-pub-sharebutton-whatsapp" href="{{ buttons.whatsapp.link }}" target="_blank" data-onclick="whatsapp" data-oid="{{ oid }}" data-action="share/whatsapp/share"{% if fpcm.shares.count %} data-count="true"{% endif %}>
                <img loading="lazy" src="{{ share_button_icon(buttons.whatsapp.icon) }}" alt="WhatsApp">
            </a>    
        </li>
        <li>
            <a class="fpcm-pub-sharebutton fpcm-pub-sharebutton-whatsapp" href="{{ buttons.email.link }}" target="_blank" data-onclick="email" data-oid="{{ oid }}"{% if fpcm.shares.count %} data-count="true"{% endif %}>
                <img loading="lazy" src="{{ share_button_icon(buttons.email.icon) }}" alt="E-Mail">
            </a>    
        </li>
    </ul>
</section>
<!-- Stop FanPress CM Share Buttons -->