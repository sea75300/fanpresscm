<section>
    <div id="commentform">
        <div class="post">
            <div class="content col-12">
                <h4>{{ form.formHeadline }}</h4>

                <form method="post" action="{{ form.submitUrl }}" name="cform">
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ form.nameField.label }}
                        </div>
                        <div class="col">
                            <input type="text" name="{{ form.nameField.name }}" value="{{ form.nameField.name }}">
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ form.emailField.label }} (wird nicht veröffentlicht)
                        </div>
                        <div class="col">
                            <input type="email" name="{{ form.emailField.name }}" value="{{ form.emailField.name }}">
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ form.websiteField.label }} (optional)
                        </div>
                        <div class="col">
                            <input type="url" name="{{ form.websiteField.name }}" value="{{ form.websiteField.name }}">
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-4">
                            {{ form.textfield.label }}
                        </div>
                        <div class="col">
                            <div>
                                <textarea name="{{ form.textfield.name }}" id="{{ form.textfield.id }}">
                                    {{ form.textfield.value }}
                                </textarea>
                            </div>
                            <div class="px-2">
                                {{ form.tags.label }}: {{ form.tags.value }}
                            </div>
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col">
                            {{ form.spamPlugin.text }}
                        </div>
                        <div class="col">
                            {{ form.spamPlugin.field }}
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-auto">
                            <input type="checkbox" name="{{ form.privateCheckbox.name }}">
                        </div>
                        <div class="col">
                            {{ form.privateCheckbox.label }}
                        </div>
                    </div>
                    <div class="row row-cols-2">
                        <div class="col-auto">
                            <input type="checkbox" name="{{ form.privacyComfirmation.name }}">
                        </div>
                        <div class="col">
                            {{ form.privacyComfirmation.label }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col align-center">
                            <button type="submit" name="{{ form.submitButton.name }}">{{ form.submitButton.label }}</button>
                            <button type="reset" name="{{ form.resetButton.name }}">{{ form.resetButton.label }}</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>